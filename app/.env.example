# CrispSignal board, from `forge script script/Deploy.s.sol` (contracts/). Required.
VITE_BOARD_ADDRESS=

# Sepolia JSON-RPC used for every chain read and for the CRISP SDK.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Hosted CRISP server: ciphertext staging, availability attestation and vote relay.
VITE_CRISP_SERVER_URL=https://private-crisp.theinterfold.com

# IPFS reads go through this gateway.
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Server only (no VITE_ prefix, never bundled): the Pinata JWT used by the /api/pin function.
# `npm run dev` serves that function too. Scope the key to pinJSONToIPFS.
PINATA_JWT=

# Optional: adds WalletConnect (mobile wallets via QR) to the wallet modal. Get an id at
# https://cloud.reown.com and allow the app's domains there.
VITE_WALLETCONNECT_PROJECT_ID=
