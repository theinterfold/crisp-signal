# CrispSignalAztec board, from `forge script script/Deploy.s.sol` (contracts/). Required.
VITE_BOARD_ADDRESS=

# Sepolia JSON-RPC used for every Ethereum read.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Hosted CRISP server in Aztec mode: committee key, ciphertext staging and availability attestation.
VITE_CRISP_SERVER_URL=https://private-crisp.theinterfold.com/aztec

# Aztec testnet node: registrations and ballots are sent through it, and a round's status is read from its public logs.
VITE_AZTEC_NODE_URL=https://aztec-testnet.drpc.org

# The domain voters' ZKPassport proofs are made for. It must be the one the Aztec CRISP contract was deployed with.
VITE_ZKPASSPORT_DOMAIN=poll.theinterfold.com

# IPFS reads go through this gateway.
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Server only (no VITE_ prefix, never bundled): the Pinata JWT used by the /api/pin function.
# `npm run dev` serves that function too. Scope the key to pinJSONToIPFS.
PINATA_JWT=

# Optional: adds WalletConnect (mobile wallets via QR) to the wallet modal, which only poll creators use.
# Get an id at https://cloud.reown.com and allow the app's domains there.
VITE_WALLETCONNECT_PROJECT_ID=
